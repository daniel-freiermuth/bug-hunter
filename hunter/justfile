# Idle-Token Bug Hunter — development tasks
# Usage: cd hunter && just check

set dotenv-load := false

# Run all quality checks (format, lint, typecheck, test).
check: fmt-check lint typecheck typecheck-ui test

# Check formatting (no changes).
fmt-check:
    ruff format --check hunter/ tests/

# Auto-format in place.
fmt:
    ruff format hunter/ tests/

# Lint with ruff.
lint:
    ruff check hunter/ tests/

# Lint and auto-fix what's safe.
lint-fix:
    ruff check --fix hunter/ tests/

# Strict type checking — Python.
typecheck:
    mypy --strict hunter/

# Strict type checking — UI TypeScript.
typecheck-ui:
    npx tsc --project ui/tsconfig.json

# Bundle UI TypeScript → ui/app.js.
build-ui:
    npx esbuild ui/src/app.ts --bundle --outfile=ui/app.js --sourcemap --target=es2022 --format=iife

# Run the test suite.
test *ARGS:
    pytest tests/ {{ ARGS }}

# Run a single test file.  e.g. just test-one test_store
test-one NAME *ARGS:
    pytest tests/{{ NAME }}.py -v {{ ARGS }}

# Format, lint-fix, build UI, then full check (handy before committing).
fix: fmt lint-fix build-ui check

# Build UI then start the daemon (UI + scheduler loop).
daemon *ARGS: build-ui
    python3 -m hunter {{ ARGS }} daemon

# Build UI then start serve-only (no scheduler loop).
serve *ARGS: build-ui
    python3 -m hunter serve {{ ARGS }}

# hunter-rs
set shell := ["bash", "-cu"]

# Regenerate the schema-only dev DB from migrations (sqlx compile-time checks).
dev-db:
    rm -f dev.db
    for m in migrations/*.sql; do sqlite3 -bail dev.db < "$m" || exit 1; done
    @echo "dev.db regenerated from migrations"

# Full lint: clippy + SQL encapsulation guarantee
lint:
    cargo clippy --all-targets
    @echo "Checking SQL encapsulation..."
    @! grep -rn '\.pool()' src/ | grep -v 'store\.rs' | grep -v '//' && echo "✓ pool() only in store.rs" || (echo "✗ pool() leaked outside store.rs" && exit 1)
    @! grep -rn 'sqlx::query(' src/ | grep -v 'query!\|query_as!\|query_scalar!\|capacity\.rs\|//' && echo "✓ all queries compile-time checked" || (echo "✗ unchecked sqlx::query found" && exit 1)
    @! grep -rn 'QueryBuilder' src/ | grep -v '//' && echo "✓ no QueryBuilder" || (echo "✗ QueryBuilder found" && exit 1)
    @echo "All SQL guarantees hold."

check:
    cargo check --all-targets

# nextest-only: see .config/nextest.toml.
test:
    cargo nextest run

# Mutation-test one module: does the suite notice when it breaks?
mutants FILE:
    cargo mutants --test-tool nextest -j 4 --file {{FILE}}

# Run the daemon against the local hunter/ root.
run:
    cargo run -- --root ../hunter

# Build both halves of what the daemon serves.
#
# The UI bundle is generated and untracked, and the daemon reads it from
# `hunter/ui/` at request time -- so a binary built without it serves a
# working API behind a 404 page. Keeping the two builds in one recipe is
# what stops that being something to remember.
#
# Restarting is deliberately NOT here: what restarts the daemon is
# `systemctl --user restart hunter.service` (unit in hunter/hunter.service),
# and a recipe that reaches into the service manager hides which of the
# two failed and assumes the machine it runs on is the one serving.
#
# `npm ci` is deliberately absent: it wipes node_modules and costs a
# minute. Run it yourself after a dependency change.

# Build the UI bundle and the release binary.
build:
    cd ../hunter/ui-svelte && npx vite build
    cargo build --release
